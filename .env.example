# AI Supervisor secrets.
# Copy to .env, fill values, then: chmod 600 .env
# Never commit .env. Keys are never sent to the DeepSeek worker process.

# --- Kimi (primary: Kimi Code) ---
# Keys and base URLs are NOT interchangeable between Kimi Code and Moonshot.
KIMI_API_KEY=
KIMI_BASE_URL=https://api.kimi.ai/coding/v1
# Kimi Code model IDs have no "kimi-" prefix. Open Platform: kimi-k3.1-pro
KIMI_MODEL=k3.1-pro

# --- DeepSeek Harness worker ---
# The official SDK launches its bundled runtime; the key is passed only to it.
DEEPSEEK_API_KEY=
# Leave empty for the official endpoint. Example compatible endpoint: http://127.0.0.1:8000/v1
DEEPSEEK_BASE_URL=
# Empty means config.toml [deepseek].model (deepseek-v4-flash).
DEEPSEEK_MODEL=

# --- Telegram ---
# Create a bot with @BotFather. Numeric user ID from @userinfobot (not a username).
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_ID=

# Optional: rotate/override the config file location.
# AI_SUPERVISOR_CONFIG=/absolute/path/to/config.toml
