# AI Supervisor secrets and personal identifiers ONLY.
# Copy to .env, fill values, then: chmod 600 .env
# Never commit .env. Regular settings belong in config.toml.
#
# Worker processes receive only DEEPSEEK_API_KEY; no control-provider key
# is passed to the sandbox.

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
# Numeric user ID from @userinfobot, not a username.
TELEGRAM_OWNER_ID=

# --- Kimi (control model, optional if another provider is selected) ---
KIMI_API_KEY=

# --- DeepSeek Harness (execution backend, required) ---
DEEPSEEK_API_KEY=

# --- OpenAI (control model, optional) ---
OPENAI_API_KEY=

# --- Custom OpenAI-compatible provider (optional) ---
OPENAI_COMPATIBLE_API_KEY=

# --- GitHub (optional; API and HTTPS Git operations) ---
GITHUB_TOKEN=
